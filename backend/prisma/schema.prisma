generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  WAITER
  COOK
}

enum MealStatus {
  VALIDATION
  IN_PROGRESS
  READY
  SERVED
  CANCELED
}

model Restaurant {
  id     Int    @id @default(autoincrement())
  name   String
  code   String @unique

  users  User[]
  orders Order[]
  messages Message[]
}

model User {
  id           Int    @id @default(autoincrement())
  role         Role
  name         String
  matricule    String
  password     String

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orders       Order[]
  messages Message[]

  @@unique([matricule, restaurantId])
}

model Order {
  id           Int   @id @default(autoincrement())
  tableNumber  Int
  idempotencyKey String? @unique

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  waiterId     Int
  waiter       User @relation(fields: [waiterId], references: [id])

  meals        Meal[]
  outboxEvents OutboxEvent[]

  @@index([restaurantId, id])
}

model OutboxEvent {
  id             Int       @id @default(autoincrement())
  type           String
  restaurantCode String
  roles          Json
  payload        Json
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id])
  attempts       Int       @default(0)
  claimedAt      DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt, id])
}

model Meal {
  id        Int        @id @default(autoincrement())
  status    MealStatus
  createdAt DateTime @default(now())
  name      String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  comment   String?

  orderId   Int
  order     Order @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

model Message {
  id           Int      @id @default(autoincrement())
  content      String
  createdAt    DateTime @default(now())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  authorId     Int
  author       User @relation(fields: [authorId], references: [id])

  @@index([restaurantId, id])
}