generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  WAITER
  COOK
}

enum MealStatus {
  VALIDATION
  IN_PROGRESS
  READY
  SERVED
  CANCELED
}

model Restaurant {
  id     Int    @id @default(autoincrement())
  name   String @unique

  users  User[]
  orders Order[]
}

model User {
  id           Int    @id @default(autoincrement())
  role         Role
  name         String @unique
  password     String

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orders       Order[] // commandes créées par ce user (waiter)
}

model Order {
  id           Int   @id @default(autoincrement())
  table        Int

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  waiterId     Int
  waiter       User @relation(fields: [waiterId], references: [id])

  meals        Meal[]
}

model Meal {
  id        Int        @id @default(autoincrement())
  status    MealStatus
  date      DateTime
  quantity  Int
  price     Float
  comment   String

  orderId   Int
  order     Order @relation(fields: [orderId], references: [id])
}