generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  WAITER
  COOK
}

enum MealStatus {
  VALIDATION
  IN_PROGRESS
  READY
  SERVED
  CANCELED
}

model Restaurant {
  id     Int    @id @default(autoincrement())
  name   String
  code   String @unique

  users  User[]
  orders Order[]
  messages Message[]
}

model User {
  id           Int    @id @default(autoincrement())
  role         Role
  name         String
  matricule    String
  password     String

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orders       Order[]
  messages Message[]

  @@unique([matricule, restaurantId])
}

model Order {
  id           Int   @id @default(autoincrement())
  tableNumber  Int

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  waiterId     Int
  waiter       User @relation(fields: [waiterId], references: [id])

  meals        Meal[]
}

model Meal {
  id        Int        @id @default(autoincrement())
  status    MealStatus
  createdAt DateTime @default(now())
  quantity  Int
  price     Float
  comment   String?

  orderId   Int
  order     Order @relation(fields: [orderId], references: [id])
}

model Message {
  id           Int      @id @default(autoincrement())
  content      String
  createdAt    DateTime @default(now())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  authorId     Int
  author       User @relation(fields: [authorId], references: [id])

  @@index([restaurantId, id])
}